+// Set NUNCHAKU_SYNC_ALLOC=1 to allocate with plain cudaMalloc instead of
+// cudaMallocAsync. Motivation: the FIRST cudaMallocAsync on this device creates
+// the default memory pool and reserves a ~1.44 GB arena, regardless of the
+// requested size (measured: a 128x128 GEMM triggers the full 1.44 GB). On an 8B
+// model that fixed cost is ~20% of the reported INT4 footprint, and it is not
+// reclaimable via cudaMemPoolTrimTo (which only recovers ~0.15 GB). All of
+// nunchaku's device buffers here are long-lived (allocated once at load /
+// first-forward and then reused), so the async allocator's fast
+// alloc/free-in-a-stream advantage is not needed for them.
+inline bool nunchakuUseSyncAlloc() {
+    static const bool v = [] {
+        const char *e = std::getenv("NUNCHAKU_SYNC_ALLOC");
+        return e && e[0] == '1';
+    }();
+    return v;
+}
