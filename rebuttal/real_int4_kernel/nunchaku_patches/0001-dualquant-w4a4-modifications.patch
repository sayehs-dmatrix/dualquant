+        nunchaku::kernels::gemm_w4a4(
+            cached_act_st, net->qweight, outT, {},
+            cached_ascales_st, net->wscales, {}, {},
+            cached_lora_act_st, net->lora_up, {}, {},
+            {}, {}, {},
+            net->bias, {}, {}, {},
+            false, net->lora_scales, false
+        );
+
+        stackCUDAStreams.pop();
+        return out_torch_st;
+    }
+
+    // ── forward_beta: fuses DualQuant's per-channel beta rescale into this
+    // one C++ call, instead of the caller doing `x * beta` as a separate
+    // Python-level aten::mul first. Profiling on the real model showed that
+    // separate multiply costs ~16.5us of CPU dispatch overhead per call
+    // (ATen dispatcher + autograd guard + device dispatch) for ~1.4us of
+    // actual GPU work -- at 224 linear layers/token that's ~8.5ms of a
+    // ~33ms decode step, i.e. the single largest CPU-side cost in the whole
+    // profile. NOTE: this does the multiply with a plain custom kernel
+    // (mul_broadcast_lastdim_bf16), NOT by routing beta through nunchaku's
+    // own "smooth" mechanism -- that path was already proven to corrupt
+    // accuracy on DualQuant's wide-dynamic-range beta (PPL 6.73 -> 26905).
+    torch::Tensor forward_beta(torch::Tensor x, torch::Tensor beta) {
+        checkModel();
+        x = x.contiguous();
+        beta = beta.contiguous();
+        Tensor xt = from_torch(x);
+        Tensor betat = from_torch(beta);
+
+        const int actualM = (int)(xt.numel() / xt.shape[-1]);
+        const int K = (int)xt.shape[-1];
+        const int BLOCK_M = 128;
+        const int M = ceilDiv(actualM, BLOCK_M) * BLOCK_M;
+
+        Device dev = net->qweight.device();
+
+        if (M != cached_M) {
+            cached_act = Tensor::allocate({M, net->in_features_pad / 2}, Tensor::INT8, dev);
+            cached_ascales = Tensor::allocate({net->in_features_pad / 64, M}, net->dtype, dev);
+            cached_lora_act = Tensor::allocate({M, net->lora_rank}, Tensor::FP32, dev);
+            cached_M = M;
+        }
+        if (!cached_beta_input.valid() || cached_beta_input.shape.dataExtent != xt.shape.dataExtent) {
+            cached_beta_input = Tensor::allocate(xt.shape.dataExtent, xt.dtype(), dev);
+        }
+
+        // Explicit stream: must match the stream quantize_w4a4_act_fuse_lora/
+        // gemm_w4a4 below actually run on (getCurrentCUDAStream()), since the
+        // legacy/default stream this kernel would otherwise launch on gives
+        // no implicit ordering guarantee against PyTorch's own (non-blocking)
+        // stream -- the same class of bug fixed for forward_graph's raw
+        // <<<>>> launches.
+        nunchaku::kernels::mul_broadcast_lastdim_bf16(
+            xt.data_ptr<__nv_bfloat16>(), betat.data_ptr<__nv_bfloat16>(),
+            cached_beta_input.data_ptr<__nv_bfloat16>(), xt.numel(), K,
+            at::cuda::getCurrentCUDAStream().stream()
+        );
+
+        nunchaku::kernels::quantize_w4a4_act_fuse_lora(
+            cached_beta_input, cached_act, cached_ascales, net->lora_down, cached_lora_act, net->smooth, false
+        );
+
+        TensorShape outShape(xt.shape.dataExtent);
+        outShape[-1] = net->out_features;
+        if (!cached_out.valid() || cached_out.shape.dataExtent != outShape.dataExtent) {
+            cached_out = Tensor::allocate(outShape, net->dtype, dev);
+        }
+
+        nunchaku::kernels::gemm_w4a4(
+            cached_act, net->qweight, cached_out, {},
+            cached_ascales, net->wscales, {}, {},
+            cached_lora_act, net->lora_up, {}, {},
+            {}, {}, {},
+            net->bias, {}, {}, {},
+            false, net->lora_scales, false
+        );
+
+        return to_torch(cached_out);
+    }
+
+    torch::Tensor forward_fast(torch::Tensor x) {
+        checkModel();
+        x = x.contiguous();
+        Tensor xt = from_torch(x);
+
+        const int actualM = (int)(xt.numel() / xt.shape[-1]);
+        const int BLOCK_M = 128;  // must match GEMMConfig_W4A4::BLOCK_M in gemm_base.cuh
+        const int M = ceilDiv(actualM, BLOCK_M) * BLOCK_M;
+
+        Device dev = net->qweight.device();
+
+        if (M != cached_M) {
+            cached_act = Tensor::allocate({M, net->in_features_pad / 2}, Tensor::INT8, dev);
+            cached_ascales = Tensor::allocate({net->in_features_pad / 64, M}, net->dtype, dev);
+            cached_lora_act = Tensor::allocate({M, net->lora_rank}, Tensor::FP32, dev);
+            cached_M = M;
+        }
+
+        nunchaku::kernels::quantize_w4a4_act_fuse_lora(
+            xt, cached_act, cached_ascales, net->lora_down, cached_lora_act, net->smooth, false
+        );
+
+        TensorShape outShape(xt.shape.dataExtent);
+        outShape[-1] = net->out_features;
+        if (!cached_out.valid() || cached_out.shape.dataExtent != outShape.dataExtent) {
+            cached_out = Tensor::allocate(outShape, net->dtype, dev);
+        }
+
+        nunchaku::kernels::gemm_w4a4(
+            cached_act, net->qweight, cached_out, {},          // act, wgt, out, qout
+            cached_ascales, net->wscales, {}, {},               // ascales, wscales, oscales, poolout
+            cached_lora_act, net->lora_up, {}, {},               // lora_act_in, lora_up, lora_down(next), lora_act_out(next)
+            {}, {}, {},                                          // norm_q, norm_k, rotary_emb
+            net->bias, {}, {}, {},                               // bias, smooth_factor(next), out_vk, out_linearattn
+            false, net->lora_scales, false                       // act_unsigned, lora_scales, fuse_silu
+        );
+
+        // NOTE: deliberately NOT calling Tensor::synchronizeDevice() here.
+        // That call is cudaDeviceSynchronize() -- a full blocking device-wide
+        // sync -- and forward()/quantize() call it after EVERY invocation.
+        // At LLM decode call volumes (hundreds of calls/token) that forced
+        // host-device round trip dominates latency (~30-90us fixed, regardless
+        // of M) and serializes work that would otherwise pipeline on the
+        // stream. All our kernels (and PyTorch's own ops) run on the default
+        // CUDA stream, so ordering is preserved without an explicit sync;
+        // PyTorch/the caller syncs naturally at the point a result is actually
+        // needed (e.g. .item(), .cpu(), or the timing harness's own sync).
+        return to_torch(cached_out);
+    }
+
+    // ── CUDA-graph fast path ────────────────────────────────────────────────
+    // forward_fast still pays two separate CPU->driver kernel-launch calls
+    // per forward (quantize_w4a4_act_fuse_lora, then gemm_w4a4). For small
+    // shapes (q/k/v/o_proj) that fixed launch overhead dominates over the
+    // actual (tiny) memory traffic -- measured ~13x the theoretical
+    // memory-bound time for k/v_proj. CUDA graphs capture the whole
+    // fixed-shape op sequence ONCE and replay it as a SINGLE driver call,
+    // removing that per-launch dispatch overhead.
+    //
+    // Graphs require fixed memory addresses for every op captured, but the
+    // input tensor's address changes every call (fresh activation from the
+    // model each token) -- so we copy the caller's input into our own
+    // persistent `cached_input` buffer first (a plain async memcpy, NOT
+    // part of the captured graph, source address is free to vary), then
+    // replay the captured graph, which only ever touches our own fixed
+    // buffers (cached_input/act/ascales/lora_act/out) and the model's
+    // weight tensors (qweight/wscales/smooth/bias, fixed for the module's
+    // lifetime).
+    Tensor cached_input;
+    int cached_actualM = -1;                // actual (unpadded) M cached_input was sized for
+    cudaGraphExec_t graphExec = nullptr;
+    int graphExec_M = -1;
+    cudaStream_t captureStream = nullptr;   // dedicated non-null stream (legacy/NULL stream 0 can't be captured)
+    cudaEvent_t inputReadyEvent = nullptr;  // PyTorch's stream -> captureStream handoff
+    cudaEvent_t outputReadyEvent = nullptr; // captureStream -> PyTorch's stream handoff
+
+    // Separate state for forward_graph_beta's "no-stream-switch" variant:
+    // captures directly on the CALLER's current stream (at::cuda::getCurrentCUDAStream()),
+    // instead of a dedicated captureStream + cross-stream events. Only valid
+    // when the caller's current stream is itself non-null (i.e. the caller
+    // put torch under a custom torch.cuda.Stream(), NOT the default legacy
+    // stream 0 -- stream 0 can never be captured). Kept separate from
+    // graphExec/cached_input above so this and forward_graph don't collide.
+    // Fully independent scratch buffers (NOT shared with forward_fast/forward_beta/
+    // forward_graph's cached_act/cached_ascales/cached_lora_act/cached_out/cached_M):
+    // those methods track their own buffers' current size via their own "cached_M"
+    // variable, so if forward_graph_beta reallocated the SHARED buffers to a
+    // different size, the other methods' size-tracking would be silently stale,
+    // and vice versa -- either direction corrupts data or (worse) leaves a
+    // captured graph's baked-in pointers referencing a freed/resized buffer.
+    // Confirmed via a cross-check test (forward_graph_beta interleaved with
+    // forward_beta on the same instance): sharing buffers broke on the first
+    // call after an interleave. Independent buffers cost nothing extra in
+    // practice since real usage picks ONE forward variant per module.
+    Tensor cached_input_ns;
+    Tensor cached_act_ns, cached_ascales_ns, cached_lora_act_ns, cached_out_ns;
+    int cached_actualM_ns = -1;
+    int cached_M_ns = -1;
+    cudaGraphExec_t graphExecNS = nullptr;
+    int graphExecNS_M = -1;
+    cudaStream_t graphExecNS_stream = nullptr;  // stream the current graphExecNS was captured on
+
+    // ── forward_graph_beta_fused: fold the beta-multiply INTO the captured
+    // graph too, instead of launching it separately every call. ────────────
+    // forward_graph_beta still pays 2 host-side launches/call: the mul
+    // kernel (outside the graph, since its INPUT address changes every
+    // call and a captured node's args are fixed at capture time) + the
+    // graph replay itself. Measured floor for small shapes (q/k/v/o_proj,
+    // M<=64): ~28-30us, matching BF16's OWN floor almost exactly -- i.e.
+    // launch/dispatch count, not bandwidth, is the wall.
+    //
+    // CUDA graphs support exactly this "same shape, different pointer"
+    // case via cudaGraphExecKernelNodeSetParams: update ONE captured
+    // kernel node's argument in place (a cheap driver-side operation, no
+    // new kernel dispatch) instead of issuing a whole separate launch.
+    // This folds mul+quantize+gemm into ONE graph, replayed via ONE
+    // cudaGraphLaunch, preceded by ONE (hopefully cheaper) SetParams call
+    // instead of a full kernel launch -- 2 host calls either way, but if
+    // SetParams is meaningfully cheaper than a kernel launch, this wins.
+    // Whether it actually is cheaper is exactly what needs measuring, not
+    // assuming -- hence a separate method, isolated buffers, validated
+    // independently before ever being wired into the model.
+    Tensor cached_input_nsf;
+    Tensor cached_act_nsf, cached_ascales_nsf, cached_lora_act_nsf, cached_out_nsf;
+    int cached_actualM_nsf = -1;
+    int cached_M_nsf = -1;
+    cudaGraphExec_t graphExecNSF = nullptr;
+    int graphExecNSF_M = -1;
+    cudaStream_t graphExecNSF_stream = nullptr;
+    cudaGraph_t templateGraphNSF = nullptr;  // kept alive: node handles below are only valid while it exists
+    cudaGraphNode_t mulNodeNSF = nullptr;
+    // Stable storage the mul kernel's cudaKernelNodeParams.kernelParams array
+    // points to -- SetParams copies the VALUES here into the graph node, so
+    // these must hold the CURRENT call's argument values at SetParams time.
+    const __nv_bfloat16* mulArgX_nsf = nullptr;
+    const __nv_bfloat16* mulArgBeta_nsf = nullptr;
+    __nv_bfloat16* mulArgOut_nsf = nullptr;
+    long long mulArgNumel_nsf = 0;
+    int mulArgK_nsf = 0;
+
+    torch::Tensor forward_graph_beta_fused(torch::Tensor x, torch::Tensor beta) {
+        checkModel();
+        x = x.contiguous();
+        beta = beta.contiguous();
+        Tensor xt = from_torch(x);
+        Tensor betat = from_torch(beta);
+
+        cudaStream_t cur = at::cuda::getCurrentCUDAStream().stream();
+        if (cur == nullptr) {
+            throw std::runtime_error(
+                "forward_graph_beta_fused requires a non-default CUDA stream -- wrap the "
+                "call site in `with torch.cuda.stream(s):` using a torch.cuda.Stream() instance."
+            );
+        }
+
+        const int actualM = (int)(xt.numel() / xt.shape[-1]);
+        const int K = (int)xt.shape[-1];
+        const int BLOCK_M = 128;
+        const int M = ceilDiv(actualM, BLOCK_M) * BLOCK_M;
+
+        Device dev = net->qweight.device();
+
+        if (cur != graphExecNSF_stream) {
+            if (graphExecNSF != nullptr) {
+                checkCUDA(cudaGraphExecDestroy(graphExecNSF));
+                graphExecNSF = nullptr;
+            }
+            if (templateGraphNSF != nullptr) {
+                checkCUDA(cudaGraphDestroy(templateGraphNSF));
+                templateGraphNSF = nullptr;
+            }
+            mulNodeNSF = nullptr;
+            graphExecNSF_M = -1;
+            graphExecNSF_stream = cur;
+        }
+
+        if (M != cached_M_nsf || actualM != cached_actualM_nsf) {
+            if (graphExecNSF != nullptr) {
+                checkCUDA(cudaGraphExecDestroy(graphExecNSF));
+                graphExecNSF = nullptr;
+            }
+            if (templateGraphNSF != nullptr) {
+                checkCUDA(cudaGraphDestroy(templateGraphNSF));
+                templateGraphNSF = nullptr;
+            }
+            mulNodeNSF = nullptr;
+            graphExecNSF_M = -1;
+            cached_act_nsf = Tensor::allocate({M, net->in_features_pad / 2}, Tensor::INT8, dev);
+            cached_ascales_nsf = Tensor::allocate({net->in_features_pad / 64, M}, net->dtype, dev);
+            cached_lora_act_nsf = Tensor::allocate({M, net->lora_rank}, Tensor::FP32, dev);
+            cached_input_nsf = Tensor::allocate({actualM, K}, xt.dtype(), dev);
+            cached_M_nsf = M;
+            cached_actualM_nsf = actualM;
+        }
+
+        TensorShape outShape(xt.shape.dataExtent);
+        outShape[-1] = net->out_features;
+        if (!cached_out_nsf.valid() || cached_out_nsf.shape.dataExtent != outShape.dataExtent) {
+            cached_out_nsf = Tensor::allocate(outShape, net->dtype, dev);
+        }
+
+        // Always refresh the storage the mul kernel node's params point to,
+        // BEFORE either capturing (first time) or updating via SetParams
+        // (subsequent calls) -- both read these member variables' current
+        // values, not the call's local xt/betat directly.
+        mulArgX_nsf = xt.data_ptr<__nv_bfloat16>();
+        mulArgBeta_nsf = betat.data_ptr<__nv_bfloat16>();
+        mulArgOut_nsf = cached_input_nsf.data_ptr<__nv_bfloat16>();
+        mulArgNumel_nsf = xt.numel();
+        mulArgK_nsf = K;
+
+        stackCUDAStreams.push(cur);
+
+        if (graphExecNSF == nullptr) {
+            // First-ever build for this (stream, M) combo: capture mul +
+            // quantize + gemm together, in ONE graph.
+            nunchaku::kernels::mul_broadcast_lastdim_bf16(
+                mulArgX_nsf, mulArgBeta_nsf, mulArgOut_nsf, mulArgNumel_nsf, mulArgK_nsf, cur
+            );
+            nunchaku::kernels::quantize_w4a4_act_fuse_lora(
+                cached_input_nsf, cached_act_nsf, cached_ascales_nsf, net->lora_down, cached_lora_act_nsf, net->smooth, false
+            );
+            nunchaku::kernels::gemm_w4a4(
+                cached_act_nsf, net->qweight, cached_out_nsf, {},
+                cached_ascales_nsf, net->wscales, {}, {},
+                cached_lora_act_nsf, net->lora_up, {}, {},
+                {}, {}, {},
+                net->bias, {}, {}, {},
+                false, net->lora_scales, false
+            );
+            checkCUDA(cudaStreamSynchronize(cur));
+
+            checkCUDA(cudaStreamBeginCapture(cur, cudaStreamCaptureModeThreadLocal));
+            nunchaku::kernels::mul_broadcast_lastdim_bf16(
+                mulArgX_nsf, mulArgBeta_nsf, mulArgOut_nsf, mulArgNumel_nsf, mulArgK_nsf, cur
+            );
+            nunchaku::kernels::quantize_w4a4_act_fuse_lora(
