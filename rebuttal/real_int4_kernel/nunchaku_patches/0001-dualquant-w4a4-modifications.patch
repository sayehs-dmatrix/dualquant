+    // ── Persistent-buffer fast path ─────────────────────────────────────────
+    // GEMM_W4A4::forward() (used by forward() above) calls quantize(), which
+    // calls Tensor::allocate() (== cudaMallocAsync) for act/ascales/lora_act
+    // on EVERY call, then frees them when the QuantizedActivation goes out of
+    // scope (cudaFreeAsync) -- plus forward_quant() allocates a fresh output
+    // tensor too. That's 4 cudaMallocAsync + 4 cudaFreeAsync calls per
+    // forward(), which dominates latency at LLM decode call volumes (M=1,
+    // hundreds of calls per token). Since M is constant across an
+    // autoregressive decode loop (or a fixed-shape prefill), we cache and
+    // reuse these buffers across calls instead of reallocating every time,
+    // replicating GEMM_W4A4::quantize()+forward_quant()'s EMPTY-fuse-path
+    // logic directly against the cached buffers (see Linear.cpp for the
+    // reference call this mirrors).
+    //
+    // SAFETY: the returned tensor aliases cached_out's storage; it stays
+    // valid until the NEXT forward_fast() call on this same instance (which
+    // is exactly the lifetime a normal sequential forward pass needs: the
+    // output is consumed by the next op before this layer is called again
+    // next token/step).
+    Tensor cached_act, cached_ascales, cached_lora_act, cached_out;
+    int cached_M = -1;
+    Tensor cached_beta_input;   // scratch buffer for x*beta, used by forward_beta only
+
+    // ── forward_static: designed to be legal INSIDE an OUTER CUDA graph
+    // capture that spans the whole model decode step (see
+    // whole_step_graph_decode.py). Requirements that forced a new method:
+    //   1. NO internal cudaStreamBeginCapture (forward_graph* would nest
+    //      captures -- illegal).
+    //   2. NO allocation during capture. nunchaku's Tensor::allocate calls
+    //      cudaMallocAsync on the LEGACY stream 0 (Tensor.h BufferCUDA), which
+    //      is illegal mid-capture. So all scratch is allocated on the first
+    //      (warm-up) call, and capture must happen at the SAME M.
+    //   3. Internal kernels must launch on the CAPTURE stream. nunchaku's own
+    //      getCurrentCUDAStream() reads its thread-local stackCUDAStreams
+    //      (empty => legacy stream 0), so this pushes PyTorch's current stream
+    //      (== the capture stream inside torch.cuda.graph) for the duration.
+    //      Without this the internal quantize/gemm kernels would go to stream
+    //      0 and either fail capture or be silently omitted from the graph --
+    //      the exact bug class already hit once in forward_graph.
+    //   4. NO to_torch() on the output: to_torch allocates a fresh torch
+    //      tensor AND does an extra device-to-device copy every call. Instead
+    //      the output torch tensor is allocated once and written in place, so
+    //      the graph bakes in a stable address and the caller reads results
+    //      from that same tensor after each replay.
+    Tensor cached_act_st, cached_ascales_st, cached_lora_act_st, cached_beta_input_st;
+    torch::Tensor out_torch_st;
+    int cached_M_st = -1, cached_actualM_st = -1;
+
+    torch::Tensor forward_static(torch::Tensor x, torch::Tensor beta) {
+        checkModel();
+        x = x.contiguous();
+        beta = beta.contiguous();
+        Tensor xt = from_torch(x);
+        Tensor betat = from_torch(beta);
+
+        const int actualM = (int)(xt.numel() / xt.shape[-1]);
+        const int K = (int)xt.shape[-1];
+        const int BLOCK_M = 128;
+        const int M = ceilDiv(actualM, BLOCK_M) * BLOCK_M;
+
+        Device dev = net->qweight.device();
+
+        // Allocation path -- MUST NOT be reached during an outer graph capture
+        // (cudaMallocAsync on legacy stream 0 is illegal there). Warm up with
+        // the same M before capturing.
+        if (M != cached_M_st || actualM != cached_actualM_st) {
+            cached_act_st = Tensor::allocate({M, net->in_features_pad / 2}, Tensor::INT8, dev);
+            cached_ascales_st = Tensor::allocate({net->in_features_pad / 64, M}, net->dtype, dev);
+            cached_lora_act_st = Tensor::allocate({M, net->lora_rank}, Tensor::FP32, dev);
+            cached_beta_input_st = Tensor::allocate({actualM, K}, xt.dtype(), dev);
+            out_torch_st = torch::empty(
+                {actualM, net->out_features},
+                torch::TensorOptions().dtype(x.scalar_type()).device(x.device())
+            );
+            cached_M_st = M;
+            cached_actualM_st = actualM;
+        }
+
+        cudaStream_t cur = at::cuda::getCurrentCUDAStream().stream();
+        stackCUDAStreams.push(cur);
+
+        // beta is applied INSIDE the quantize kernel (load_act_to_fpsum reads
+        // the activation from global memory and multiplies as it loads), so
+        // there is no separate elementwise multiply kernel here. At 224 linear
+        // layers per decode step that removes 224 kernels/step; with the whole
+        // decode step captured as one CUDA graph, per-kernel cost is GPU-side
+        // fixed overhead, which is what actually bounds this regime.
+        nunchaku::kernels::quantize_w4a4_act_fuse_lora(
